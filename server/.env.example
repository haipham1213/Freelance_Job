PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/student_marketplace
CLIENT_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=Viec Lam SV <onboarding@resend.dev>
JWT_ACCESS_SECRET=
# Khóa ký link CV (bỏ trống thì dùng JWT_ACCESS_SECRET)
FILE_SIGN_SECRET=
# Frontend gọi thẳng API khác site thì đặt none (cần HTTPS); proxy /api về cùng domain thì để trống (lax)
COOKIE_SAMESITE=
# Số request/phút cho nhóm auth (NFR-07)
AUTH_RATE_LIMIT=10
# SePay Payment Gateway (https://my.sepay.vn/pg): lấy Merchant ID + Secret Key ở cổng thanh toán, IPN Secret là tùy chọn
# sandbox dùng khóa SP-TEST-…; lên production đổi SEPAY_ENV=production và dùng khóa live
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# IPN trong SePay: URL $API_URL/api/v1/payments/sepay-ipn (local: dùng ngrok). Nếu SePay cho chọn xác thực Secret Key thì đặt cùng giá trị này;
# còn không (không có header) server tự hỏi lại API SePay để lấy trạng thái đơn thật, không tin nội dung IPN
SEPAY_IPN_SECRET=
API_URL=http://localhost:5050
ADMIN_EMAIL=admin@studentjobs.local
ADMIN_PASSWORD=
